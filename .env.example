# Copy to .env and fill in values. Never commit .env — it's gitignored.
# This file is read two ways: directly by `uv run`/`pnpm` commands on the
# host (dev), and via `env_file: .env` by every compose service (containers,
# both dev and prod — see compose.yml, compose.dev.yml, compose.prod.yml,
# DEPLOY.md). Every variable below is documented, so a container that boots
# into a broken state fails loudly rather than silently — see
# f1_api.env_check (only enforced when F1_ENV=production).

# --- Database (TimescaleDB/pgvector) -----------------------------------
# Credentials for the `db` compose service (also used to build F1_STORE_DSN
# for the api/worker services automatically — see compose.yml). Change the
# password before deploying anywhere but localhost.
POSTGRES_USER=pitwall
POSTGRES_PASSWORD=pitwall
POSTGRES_DB=pitwall

# The one DSN every Python package reads (f1_store.config.DSN_ENV_VAR).
# Only needed OUTSIDE compose — e.g. running `uv run f1-store-migrate` from
# the host against the dev container's published port. Inside compose, the
# api/worker services get this built automatically from POSTGRES_* above.
# F1_STORE_DSN=postgresql://pitwall:pitwall@localhost:5432/pitwall

# --- Frontend --------------------------------------------------------------
# Where the web container finds a running f1_api. In prod this MUST be an
# absolute URL (scheme + host), e.g. https://pitwall.example.com/api — see
# apps/web/.env.example for why a bare "/api" doesn't work.
PUBLIC_F1_API_BASE_URL=http://127.0.0.1:8000

# --- Public beta feedback (server-side only — never ship these to the frontend) ---
# F1_FEEDBACK_TO=danielshdeed1995.ds@gmail.com
# F1_FEEDBACK_IP_SALT=change-me
# F1_TURNSTILE_SECRET=
# F1_SMTP_HOST=
# F1_SMTP_PORT=587
# F1_SMTP_USERNAME=
# F1_SMTP_PASSWORD=
# F1_SMTP_FROM=noreply@example.com
# F1_SMTP_USE_TLS=1

# --- Phase 5 why-engine ------------------------------------------------
# Unset: explanations degrade to a declining mock (no live key needed for
# dev/CI). Required in production for real grounded explanations.
# ANTHROPIC_API_KEY=

# --- Phase 0/backfill --------------------------------------------------
# Where FastF1's on-disk cache lives. Inside compose this is always
# data/fastf1_cache under the shared pitwall-data volume; only needed here
# for host-side (non-container) backfill runs.
FASTF1_CACHE_DIR=./data/fastf1_cache

# --- Deploy (DEPLOY.md) -------------------------------------------------
# Set F1_ENV=production only in compose.prod.yml (already does this for
# api) — it turns on f1_api.env_check's fail-loud startup validation.
# Never set it in dev/CI.
# F1_ENV=production

# The domain Caddy requests a TLS cert for (deploy/Caddyfile). Left at
# "localhost" for local prod-overlay testing without real DNS.
DOMAIN=localhost

# ghcr.io/<GHCR_NAMESPACE>/pitwall-{api,web} — normally "<github-owner>/<repo>"
# (lowercase; matches what .github/workflows/ci.yml pushes).
GHCR_NAMESPACE=yourname/f1dashboard

# The tag `just up`/compose currently run — `just deploy` updates this on
# the VPS automatically; only set by hand for a manual `docker compose pull`.
IMAGE_TAG=latest

# Where `just deploy`/`just rollback` SSH to (see DEPLOY.md's first-time
# host setup). DEPLOY_PATH is the directory on the host containing this
# same compose.yml/.env (and where `.last-deployed-sha` is written).
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_PATH=/opt/pitwall

# Build metadata — set as Docker --build-arg by CI/`just deploy`, never by
# hand. Documented here so the shape is visible; leaving these unset locally
# is normal (f1_api.config/apps/web's webBuildInfo() both default to
# "dev"/"unknown").
# GIT_SHA=
# BUILD_TIME=
