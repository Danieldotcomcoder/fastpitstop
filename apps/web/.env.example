# Base URL of a running f1_api instance (see docs/PHASE3.md — `just serve-api`).
# Must be PUBLIC_-prefixed to reach client-side code (SvelteKit convention).
# In production (see DEPLOY.md) this must be an ABSOLUTE URL including scheme
# and host — e.g. https://pitwall.example.com/api — never a bare path like
# "/api": src/lib/api/stream.ts builds a WebSocket URL with `new URL(...)`,
# which requires an absolute URL. Caddy (deploy/Caddyfile) strips the /api
# prefix and forwards to the api service unprefixed.
PUBLIC_F1_API_BASE_URL=http://127.0.0.1:8000

# This web image's own build metadata, surfaced on /status alongside the
# API's (GET /version). Set by apps/web/Dockerfile's GIT_SHA/BUILD_TIME
# build args — never set by hand in dev, where the "dev"/"unknown" defaults
# in src/lib/api/config.ts (webBuildInfo) apply.
# PUBLIC_GIT_SHA=
# PUBLIC_BUILD_TIME=
