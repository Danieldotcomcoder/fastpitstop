{
	"name": "@pitwall/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Phase 3 frontend — SvelteKit shell, design system, typed API client over f1_api, Delay Sync, track map and the composed race dashboard.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate-client": "openapi-typescript ../../python/f1_api/openapi.json -o ./src/lib/api/schema.d.ts",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"ws": "^8.21.1"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-sans-condensed": "^5.3.0",
		"openapi-fetch": "^0.17.0"
	}
}
